# Copiar a `.env` (junto a docker-compose.prod.yml) y completar. `.env` no se
# versiona ni entra a la imagen (.gitignore y .dockerignore).

# Dominio publico que apunta a este servidor (registro A). Para probar en la
# propia maquina: localhost (Caddy usa su CA interna).
VIGIA_DOMAIN=vigia.example.com

# Version de la imagen: ghcr.io/joshua203-byte/vigia-nids:<VIGIA_VERSION>
VIGIA_VERSION=1.0.0

# Clave compartida de los clientes. Generarla con:  openssl rand -hex 32
VIGIA_API_KEY=

# Opcionales (valores por defecto entre parentesis)
# VIGIA_MAX_UPLOAD_MB=200
# VIGIA_RATE_LIMIT_PER_MINUTE=30
# VIGIA_MAX_CONCURRENT_JOBS=1
# VIGIA_STORAGE_QUOTA_MB=4096
